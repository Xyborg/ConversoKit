{
  "name": "@conversokit/mcp",
  "version": "0.2.0",
  "description": "MCP Apps server adapter for ConversoKit tools and widgets.",
  "license": "Apache-2.0",
  "keywords": [
    "zod",
    "schemas",
    "types",
    "contracts",
    "conversokit",
    "chatgpt-apps",
    "mcp"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xyborg/ConversoKit.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/Xyborg/ConversoKit#readme",
  "bugs": "https://github.com/Xyborg/ConversoKit/issues",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@conversokit/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@modelcontextprotocol/ext-apps": "^1.7.0",
    "express": "^4.18.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "typescript": "^5.2.0",
    "vitest": "^1.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0"
  }
}
